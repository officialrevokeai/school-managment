{
  "name": "school-management-system",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=.env build/server/main.js",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "worker": "node --env-file-if-exists=.env build/server/worker-main.js",
    "migrate": "node --env-file-if-exists=.env build/scripts/migrate.js",
    "provision": "node --env-file-if-exists=.env build/scripts/provision.js",
    "platform:bootstrap": "node --env-file-if-exists=.env build/scripts/platform-admin.js",
    "supabase:prepare": "node --env-file-if-exists=.env build/scripts/supabase-prepare.js",
    "supabase:transfer": "node --env-file-if-exists=.env build/scripts/supabase-transfer.js",
    "build": "tsc",
    "test": "node --test --test-concurrency=1 build/test/*.test.js",
    "test:prototype": "node qa/smoke.cjs",
    "check": "npm run build && npm test && npm run test:prototype"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.8",
    "fastify": "5.12.7",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
