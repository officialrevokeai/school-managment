NODE_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:3000
PORT=3000
HOST=127.0.0.1
# Use PostgreSQL in production. Omit only for local PGlite.
DATABASE_URL=
PGLITE_PATH=./runtime/local-postgres
# Production uses a separate worker; development runs one inside the API process.
WORKER_IN_API=true
META_GRAPH_VERSION=
# The API generates account-specific variable names; replace REPLACE_WITH_ACCOUNT_KEY.
META_ACCESS_TOKEN_REPLACE_WITH_ACCOUNT_KEY=
META_APP_SECRET_REPLACE_WITH_ACCOUNT_KEY=
META_VERIFY_TOKEN_REPLACE_WITH_ACCOUNT_KEY=
RAZORPAY_KEY_ID_REPLACE_WITH_ACCOUNT_KEY=
RAZORPAY_KEY_SECRET_REPLACE_WITH_ACCOUNT_KEY=
RAZORPAY_WEBHOOK_SECRET_REPLACE_WITH_ACCOUNT_KEY=
ALLOW_LIVE_PAYMENTS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ENABLE_DEMO=false
# Docker deployment only: use independent random URL-safe passwords, never defaults.
DB_PASSWORD=
APP_DB_PASSWORD=
SCHOOL_DOMAIN=
ACME_EMAIL=
TRUST_PROXY=
BACKUP_PASSPHRASE=
BACKUP_DIRECTORY=./runtime/encrypted-backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
RESTORE_DATABASE_URL=
# Optional operator-issued one-time initial owner setup (never public sign-up).
INITIAL_SETUP_TOKEN=

# Supabase uses server-only PostgreSQL and a private schema, not public browser keys.
SUPABASE_PROJECT_REF=jvheiesrkluhxebdhunh
DB_SCHEMA=school_app
DB_POOL_SIZE=10
# Use session pooling on port 5432 or direct connection; require sslmode=verify-full.
